{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edge-finder-api/edgelab/schema_v1/market_observation.schema.json",
  "title": "MarketObservation",
  "description": "One price snapshot of one market at one point in time. Time-series, append-only — never overwritten. This is the full-market-universe capture required by EdgeLab Phase 1 section C/D.",
  "type": "object",
  "required": ["schemaVersion", "marketObservationId", "runId", "capturedAt", "marketTicker", "eventTicker", "seriesTicker", "marketFamily", "validationStatus", "parserStatus", "createdAt", "source", "provenance"],
  "properties": {
    "schemaVersion": {"$ref": "_common.schema.json#/definitions/schemaVersion"},
    "marketObservationId": {"type": "string", "description": "sha1(marketTicker + capturedAt) — see lib/edgelab/ids.py:build_market_observation_id"},
    "runId": {"type": "string"},
    "capturedAt": {"type": "string", "format": "date-time", "description": "ISO 8601 UTC timestamp of the raw snapshot this observation was read from"},
    "gameId": {"type": ["string", "null"]},
    "mlbGameId": {"type": ["string", "null"], "description": "MLB Stats API identifier when distinct from the fallback gameId"},
    "scheduledStart": {"type": ["string", "null"], "format": "date-time"},
    "awayTeam": {"type": ["string", "null"]},
    "homeTeam": {"type": ["string", "null"]},
    "seriesTicker": {"type": "string"},
    "eventTicker": {"type": "string"},
    "marketTicker": {"type": "string"},
    "marketFamily": {"type": "string"},
    "marketHorizon": {"type": ["string", "null"], "enum": ["FULL_GAME", "F3", "F5", "F7", null]},
    "title": {"type": ["string", "null"]},
    "subtitle": {"type": ["string", "null"]},
    "player": {"type": ["string", "null"]},
    "team": {"type": ["string", "null"]},
    "side": {"type": ["string", "null"]},
    "threshold": {"type": ["number", "null"]},
    "comparisonOperator": {"type": ["string", "null"], "enum": ["OVER", "UNDER", "YES", "NO", null]},
    "yesBid": {"type": ["number", "null"]},
    "yesAsk": {"type": ["number", "null"]},
    "noBid": {"type": ["number", "null"]},
    "noAsk": {"type": ["number", "null"]},
    "lastPrice": {"type": ["number", "null"]},
    "volume": {"type": ["number", "null"]},
    "openInterest": {"type": ["number", "null"]},
    "spreadCents": {"type": ["number", "null"], "description": "yesAsk - yesBid in cents, a liquidity indicator"},
    "marketStatus": {"type": ["string", "null"], "description": "e.g. active, closed, suspended"},
    "validationStatus": {"$ref": "_common.schema.json#/definitions/validationStatus"},
    "parserStatus": {"$ref": "_common.schema.json#/definitions/parserStatus"},
    "lineupConfirmationState": {"type": ["string", "null"], "enum": ["CONFIRMED", "PROJECTED", "UNKNOWN", null]},
    "checkpoint": {
      "type": ["string", "null"],
      "enum": ["FIRST_DAILY", "LINEUP_CONFIRMATION", "T_MINUS_90", "T_MINUS_60", "T_MINUS_30", "T_MINUS_15", "T_MINUS_5", "CLOSING", "INTERMEDIATE", "POST_START", null],
      "description": "Classified distance-from-scheduled-start bucket. See lib/edgelab/checkpoints.py. INTERMEDIATE = a real recurring-poll quote that doesn't land in any target bucket; still preserved."
    },
    "isClosingCandidate": {"type": ["boolean", "null"], "description": "True if this is a valid pre-suspension/pre-start tradable quote eligible to become the official closing quote"},
    "createdAt": {"type": "string", "format": "date-time"},
    "source": {"type": "string"},
    "provenance": {"$ref": "_common.schema.json#/definitions/provenance"}
  },
  "additionalProperties": false
}
